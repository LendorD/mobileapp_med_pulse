                        "description": "Семантическая ошибка (например, patient_id=0)",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResultError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/handlers.ResultError"
                        }
                    }
                }
